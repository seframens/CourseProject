<Page x:Class="IntiClient.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IntiClient.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация пользователя" Cursor="">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Border Margin="{StaticResource CardInnerPadding}" Padding="{StaticResource CardPadding}"
                Style="{StaticResource CardBorderStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Cursor="">
                <TextBlock Text="Вход в систему" Style="{StaticResource HeaderTextBlockStyle}" Margin="{StaticResource LabelMargin}"/>
                <TextBlock Text="Введите ваши данные для входа в систему" Style="{StaticResource SubHeaderTextBlockStyle}" Margin="0,0,0,20"/>

                <TextBlock Text="Логин" Style="{StaticResource TextBlockLabelStyle}"/>
                <TextBox x:Name="LoginTextBox" />

                <TextBlock Text="Пароль" Style="{StaticResource TextBlockLabelStyle}"/>
                <PasswordBox x:Name="PasswordBox" />

                <Button x:Name="LoginButton" Content="Войти" Margin="0,0,0,10" Click="LoginButton_Click"/>
                <Button x:Name="GuestButton" Content="Войти как гость" Margin="0,0,0,10" Click="GuestButton_Click"/>
                <Button x:Name="ExitButton" Content="Выйти" Margin="0,0,0,10" Click="ExitButton_Click"/>
                <TextBlock x:Name="ErrorTextBlock" Style="{StaticResource ErrorTextBlockStyle}" Visibility="Collapsed" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
