<Page x:Class="IntiClient.Pages.ProjectDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IntiClient.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProjectDetailsPage">

    <Grid Background="{StaticResource BackgroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Margin="{StaticResource CardInnerPadding}" Padding="{StaticResource CardPadding}"
                Style="{StaticResource CardBorderStyle}"
                HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="ProjectNameTextBlock" Style="{StaticResource HeaderTextBlockStyle}" Margin="{StaticResource LabelMargin}"/>
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Описание:" VerticalAlignment="Top" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBlock x:Name="DescriptionTextBlock" Grid.Row="0" Height="100" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}" Margin="5,0"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Заказчик:" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBlock x:Name="EmployerTextBlock" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}" Margin="5,0"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Руководитель:" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBlock x:Name="ManagerFullNameTextBlock" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}" Margin="5,0"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Основная квалификация руководителя:" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBlock x:Name="ManagerQualificationTextBlock" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}" Margin="5,0"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Тип работ:" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBlock x:Name="WorkTypeNameTextBlock" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}" Margin="5,0"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Дата заказа проекта:" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBlock x:Name="ProjectDateTextBlock" Grid.Row="5" Grid.Column="1" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}" Margin="5,0"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Статус:" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBlock x:Name="StatusTextBlock" Grid.Row="6" Grid.Column="1" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}" Margin="5,0"/>

                    <Label Grid.Row="7" Grid.Column="0" Content="ID Проекта:" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBlock x:Name="ProjectIdTextBlock" Grid.Row="7" Grid.Column="1" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}" Margin="5,0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <Button x:Name="EditProjectButton" Content="Редактировать проект" Margin="0,0,10,0" Click="EditProjectButton_Click"/>
                    <Button x:Name="DeleteProjectButton" Content="Удалить проект" Margin="0,0,10,0" Click="DeleteProjectButton_Click"/>
                    <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="ErrorTextBlock" Foreground="{StaticResource ErrorTextBrush}" FontSize="{StaticResource DefaultFontSize}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
