<Page x:Class="IntiClient.Pages.ProjectEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IntiClient.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
       Title="ProjectEditPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="10">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" Text="Создание и редактирование проекта" Style="{StaticResource HeaderTextBlockStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <StackPanel Height="30">
                        <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Foreground="Red" Style="{StaticResource BaseTextBlockLabelStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <Label Content="Название проекта*" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBox x:Name="NameTextBox" Margin="{StaticResource ControlMargin}"/>

                    <Label Content="Описание" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBox x:Name="DescriptionTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="{StaticResource ControlMargin}"/>

                    <Label Content="Заказчик*" Style="{StaticResource BaseLabelStyle}"/>
                    <TextBox x:Name="EmployerTextBox" Margin="{StaticResource ControlMargin}"/>

                    <Label Content="Руководитель проекта*" Style="{StaticResource BaseLabelStyle}"/>
                    <ComboBox x:Name="ManagerComboBox" Style="{StaticResource DefaultComboBoxStyle}" Margin="{StaticResource ControlMargin}"/>

                    <Label Content="Тип работ*" Style="{StaticResource BaseLabelStyle}"/>
                    <ComboBox x:Name="WorkTypeComboBox" Style="{StaticResource DefaultComboBoxStyle}" Margin="{StaticResource ControlMargin}"/>

                    <Label Content="Дата заказа проекта*" Style="{StaticResource BaseLabelStyle}"/>
                    <DatePicker x:Name="ProjectDateDatePicker" Margin="{StaticResource ControlMargin}"/>

                    <Label Content="Статус*" Style="{StaticResource BaseLabelStyle}"/>
                    <ComboBox x:Name="StatusComboBox" SelectedIndex="1" Style="{StaticResource DefaultComboBoxStyle}" Margin="{StaticResource ControlMargin}">
                        <ComboBoxItem Content="Активен"/>
                        <ComboBoxItem Content="В очереди"/>
                        <ComboBoxItem Content="Завершен"/>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="SaveButton" Content="Сохранить" Margin="5" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
